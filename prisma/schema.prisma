generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PACKING
  READY_FOR_PICKUP
  PICKED_UP
  ON_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  MPESA
  BANK
  COD
}

enum PaymentStatus {
  PENDING
  ESCROW_HELD
  PAID
  RELEASED
  FAILED
  REFUNDED
}

enum SubscriptionTier {
  FREE
  BASIC
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum SellerStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  orders       Order[]
  seller       Seller?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Seller {
  id                   String             @id @default(cuid())
  userId               String             @unique
  businessName         String
  businessType         String
  description          String?
  phone                String
  email                String
  address              String?
  logo                 String?
  status               SellerStatus       @default(PENDING)
  subscriptionTier     SubscriptionTier   @default(FREE)
  subscriptionStatus   SubscriptionStatus @default(ACTIVE)
  subscriptionExpiresAt DateTime?
  rating               Int                @default(0)
  totalOrders          Int                @default(0)
  subscriptions        SellerSubscription[]
  products             Product[]
  orders               Order[]
  adCampaigns          AdCampaign[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id])
}

model SellerSubscription {
  id           String             @id @default(cuid())
  sellerId     String
  tier         SubscriptionTier
  status       SubscriptionStatus @default(ACTIVE)
  amount       Int
  startDate    DateTime           @default(now())
  endDate      DateTime
  autoRenew    Boolean            @default(false)
  seller        Seller             @relation(fields: [sellerId], references: [id])
  createdAt    DateTime           @default(now())
}

model Product {
  id           String      @id @default(cuid())
  sellerId     String
  sku          String      @unique
  name         String
  slug         String      @unique
  description  String?
  category     String
  imageUrl     String
  price        Decimal     @db.Decimal(10, 2)
  bulkPrice    Decimal     @db.Decimal(10, 2)
  minOrder     Int
  maxOrder     Int?
  stockQty     Int         @default(0)
  discountPct  Int         @default(0)
  isActive     Boolean     @default(true)
  orderItems   OrderItem[]
  adCampaigns  AdCampaign[]
  seller       Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([isActive, createdAt(sort: Desc)])  // default listing query
  @@index([isActive, category])               // filtered by category
  @@index([isActive, sellerId])               // filtered by seller
  @@index([isActive, bulkPrice])              // price sort / range filter
  @@index([name])                             // name search (contains)
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  userId           String?
  sellerId         String
  customerName     String
  customerPhone    String
  customerEmail    String?
  addressLine1     String
  city             String
  notes            String?
  status           OrderStatus   @default(PENDING)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  subtotal         Decimal       @db.Decimal(12, 2)
  platformFee      Decimal       @db.Decimal(12, 2)
  deliveryFee      Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  escrowAmount     Decimal       @db.Decimal(12, 2)
  sellerPayout     Decimal       @db.Decimal(12, 2)
  pickupOtp       String?
  deliveryOtp     String?
  riderName        String?
  riderPhone       String?
  logisticsPartner String?
  paidAt           DateTime?
  deliveredAt      DateTime?
  items            OrderItem[]
  user             User?         @relation(fields: [userId], references: [id])
  seller           Seller        @relation(fields: [sellerId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  productImage String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
  createdAt    DateTime @default(now())
}

model AdCampaign {
  id           String        @id @default(cuid())
  sellerId     String
  productId    String?
  type         String
  startDate    DateTime
  endDate      DateTime
  dailyBudget  Decimal       @db.Decimal(10, 2)
  totalSpend   Decimal       @db.Decimal(12, 2)
  status       String        @default("ACTIVE")
  impressions  Int           @default(0)
  clicks       Int           @default(0)
  seller       Seller        @relation(fields: [sellerId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
}

model QuoteRequest {
  id          String     @id @default(cuid())
  buyerId     String
  sellerId    String
  items       Json
  description String?
  budget      Decimal?   @db.Decimal(12, 2)
  status      QuoteStatus @default(PENDING)
  sellerQuote Decimal?   @db.Decimal(12, 2)
  quoteNotes  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
